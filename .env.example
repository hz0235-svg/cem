# Database connection URL (PostgreSQL)
# Örnek: postgresql://kullanici:sifre@localhost:5432/ilan_vitrini?schema=public
# Supabase veya Neon URL de doğrudan kullanılabilir.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilan_vitrini?schema=public"

# Auth Secret (JWT ve session şifreleme için 32+ karakter gizli anahtar)
AUTH_SECRET="gizli_anahtar_ilan_vitrini_super_secret_jwt_key_2026_xyz"

# NextAuth / App URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Opsiyonel Cloudinary / S3 ayarları - varsayılan olarak /public/uploads kullanılır)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
