# Local SQLite Database (Sıfır kurulumla yerelde anında çalışır)
# Canlıda PostgreSQL kullanmak için schema.prisma içindeki provider'ı "postgresql" yapıp
# DATABASE_URL'i postgresql://... olarak ayarlayabilirsiniz.
DATABASE_URL="file:./dev.db"

# Auth Secret (JWT ve session şifreleme)
AUTH_SECRET="gizli_anahtar_ilan_vitrini_super_secret_jwt_key_2026_xyz"

# NextAuth / App URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Varsayılan olarak /public/uploads kullanılır)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
